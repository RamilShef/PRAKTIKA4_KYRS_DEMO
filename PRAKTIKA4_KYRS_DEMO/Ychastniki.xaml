<Window x:Class="PRAKTIKA4_KYRS_DEMO.Ychastniki"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAKTIKA4_KYRS_DEMO"
        mc:Ignorable="d"
         Title="Участники" MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Участники" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="PlayersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <TextBlock Text="{Binding FIO}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Email}" Foreground="Gray" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Phone}" Foreground="Gray" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding BirthDate}" Foreground="Gray" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="2"  Content="Назад" Width="100" Height="30" Click="Button_Click" Margin="10"/>
    </Grid>
</Window>
