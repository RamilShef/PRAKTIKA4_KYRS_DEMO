<Window x:Class="PRAKTIKA4_KYRS_DEMO.OrganizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAKTIKA4_KYRS_DEMO"
        mc:Ignorable="d"
          Title="Окно организатора" MinHeight="450" MinWidth="800" MaxHeight="460" MaxWidth="810"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Text="Окно Организатора"
                   FontSize="22"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   Margin="10"/>

        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
            <Border Width="150" Height="195" Background="#F4F4F4" BorderBrush="#C5C277" BorderThickness="1" Margin="0,0,0,30">
                <Image x:Name="imgUserPhoto" 
                       Stretch="Uniform"
                       Source="Image/foto.jpg"/>
            </Border>

            <Button Content="Мой профиль" Width="150" Height="50" 
                    Background="Transparent"
                    BorderBrush="#C5C277" 
                    BorderThickness="1" 
                    FontSize="16"
                    Click="Profile_Click"/>

            <Button Content="Назад" Width="150" Height="35"
                    Background="Transparent"
                    BorderBrush="#C5C277" BorderThickness="1"
                    FontSize="16"
                    Click="Button_Click" Margin="20"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock x:Name="txtGreeting"
                       Text="Доброе утро/день/вечер!" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtUserName"
                       Text="Ms/Mrs Имя" 
                       FontSize="16"
                       HorizontalAlignment="Center"/>

            <Button Content="Мероприятия" 
                    Width="220" Height="60" 
                    FontSize="16"
                    Background="#F4F4F4"
                    BorderBrush="#BEBEBE"
                    BorderThickness="1"
                    Margin="0,10"
                    Click="Event_Click"/>

            <Button Content="Участники" 
                    Width="220" Height="60" 
                    FontSize="16"
                    Background="#F4F4F4"
                    BorderBrush="#BEBEBE"
                    BorderThickness="1"
                    Margin="0,10"
                    Click="Player_Click"/>

            <Button Content="Жюри" 
                    Width="220" Height="60" 
                    FontSize="16"
                    Background="#F4F4F4"
                    BorderBrush="#BEBEBE"
                    BorderThickness="1"
                    Margin="0,10"
                    Cursor="Hand"
                    Click="Juri_Click"/>
        </StackPanel>
    </Grid>
</Window>