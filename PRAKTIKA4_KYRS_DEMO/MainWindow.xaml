<Window x:Class="PRAKTIKA4_KYRS_DEMO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAKTIKA4_KYRS_DEMO"
        mc:Ignorable="d"
        Title="Главное окно системы" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#f9f9f9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="10" VerticalAlignment="Center">
            <TextBlock Text="Мероприятия" FontSize="22" Margin="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <ComboBox x:Name="cmbDirections" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"
                         SelectionChanged="cmbDirections_SelectionChanged">
                    <ComboBoxItem Content="Все направления" IsSelected="True"/>
                </ComboBox>
                <ComboBox x:Name="cmbDateFilter" Width="200" Margin="20,0,0,0" VerticalAlignment="Center"
                         SelectionChanged="cmbDateFilter_SelectionChanged">
                    <ComboBoxItem Content="Все даты" IsSelected="True"/>
                    <ComboBoxItem Content="Сегодня"/>
                    <ComboBoxItem Content="На этой неделе"/>
                    <ComboBoxItem Content="В этом месяце"/>
                    <ComboBoxItem Content="Предстоящие"/>
                    <ComboBoxItem Content="Прошедшие"/>
                </ComboBox>

            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="EventsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Image Source="{Binding LogoPath}" Width="70" Height="70" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding NameEvent}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DirectionName}" Foreground="Gray"/>
                                <TextBlock Text="{Binding Date}" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Войти" Width="100" Height="30" Margin="0,20,0,0" HorizontalAlignment="Right" x:Name="Enter"
                Background="#4CAF50" Foreground="White"
                Click="Enter_Click"/>
    </Grid>
</Window>