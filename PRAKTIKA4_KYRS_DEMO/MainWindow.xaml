<Window x:Class="PRAKTIKA4_KYRS_DEMO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAKTIKA4_KYRS_DEMO"
        mc:Ignorable="d"
        Title="Главное окно системы" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#f9f9f9">

    <Window.Resources>
        
        <x:Array x:Key="Events" Type="{x:Type StackPanel}">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Image Source="Image/foto.jpg" Width="70" Height="70" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="IT Конференция" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Направление: Технологии" Foreground="Gray"/>
                    <TextBlock Text="Дата: 05.12.2025" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <Image Source="Image/foto.jpg" Width="70" Height="70" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Бизнес Форум" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Направление: Экономика" Foreground="Gray"/>
                    <TextBlock Text="Дата: 20.11.2025" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <Image Source="Image/foto.jpg" Width="70" Height="70" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Хакатон" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Направление: Технологии" Foreground="Gray"/>
                    <TextBlock Text="Дата: 25.11.2025" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <Image Source="Image/foto.jpg" Width="70" Height="70" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Арт-Выставка" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Направление: Искусство" Foreground="Gray"/>
                    <TextBlock Text="Дата: 10.12.2025" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </x:Array>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Мероприятия" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbDirections" Width="200" Margin="20,0,0,0" VerticalAlignment="Center">
                <ComboBoxItem Content="Все направления" IsSelected="True"/>
                <ComboBoxItem Content="Технологии"/>
                <ComboBoxItem Content="Экономика"/>
                <ComboBoxItem Content="Искусство"/>
            </ComboBox>
            <ComboBox x:Name="cmbDateFilter" Width="200" Margin="20,0,0,0" VerticalAlignment="Center">
                <ComboBoxItem Content="Все даты" IsSelected="True"/>
                <ComboBoxItem Content="Сегодня"/>
                <ComboBoxItem Content="На этой неделе"/>
                <ComboBoxItem Content="В этом месяце"/>
                <ComboBoxItem Content="Предстоящие"/>
                <ComboBoxItem Content="Прошедшие"/>
            </ComboBox>

            
            <DatePicker x:Name="dpSpecificDate" Width="150" Margin="10,0,0,0" 
                       VerticalAlignment="Center" 
                       ToolTip="Выберите конкретную дату для фильтрации"
                       IsEnabled="False"/>

            <Button Content="Войти" Width="100" Height="30" Margin="20,0,0,0" x:Name="Voiti"
                    Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50"
                    Click="Voiti_Click"/>
        </StackPanel>


        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{StaticResource Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>