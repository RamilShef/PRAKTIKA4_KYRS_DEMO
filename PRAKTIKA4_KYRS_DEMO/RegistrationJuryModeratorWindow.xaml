<Window x:Class="PRAKTIKA4_KYRS_DEMO.RegistrationJuryModeratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Добавление жюри/модератора" MinHeight="550" MinWidth="900"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.ColumnSpan="2"
                   Text="Регистрация жюри/модератора"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Левая часть формы -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- IdNumber -->
            <TextBlock Text="Id Number:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="txtID" Grid.Row="0" Grid.Column="1" Margin="0,5" IsReadOnly="True"/>

            <!-- ФИО -->
            <TextBlock Text="ФИО:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="txtFIO" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

            <!-- Пол -->
            <TextBlock Text="Пол:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="cmbGender" Grid.Row="2" Grid.Column="1" Margin="0,5">
                <ComboBoxItem Content="Мужской"/>
                <ComboBoxItem Content="Женский"/>
            </ComboBox>

            <!-- Роль -->
            <TextBlock Text="Роль:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="cmbRole" Grid.Row="3" Grid.Column="1" Margin="0,5">
                <ComboBoxItem Content="Модератор"/>
                <ComboBoxItem Content="Участник"/>
            </ComboBox>

            <!-- Email -->
            <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="txtEmail" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

            <!-- Телефон -->
            <TextBlock Text="Телефон:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="txtPhone" Grid.Row="5" Grid.Column="1" Margin="0,5" 
             Text="+7(___)___-__-__"
             GotFocus="txtPhone_GotFocus" 
             LostFocus="txtPhone_LostFocus"/>   

            <!-- Направление -->
            <TextBlock Text="Направление:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="txtDirection" Grid.Row="6" Grid.Column="1" Margin="0,5"/>

            <!-- Прикрепить к мероприятию -->
            <CheckBox x:Name="chkAttachEvent" Grid.Row="7" Grid.Column="1" Margin="0,5" Content="Прикрепить к мероприятию"/>

            <!-- Мероприятие -->
            <TextBlock Text="Мероприятие:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="cmbEvent" Grid.Row="8" Grid.Column="1" Margin="0,5">
                <ComboBoxItem Content="Хакатон 2025"/>
                <ComboBoxItem Content="IT Конференция"/>
                <ComboBoxItem Content="Бизнес Форум"/>
            </ComboBox>
            <!-- Дата рождения -->
            <TextBlock Text="Дата рождения:" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <DatePicker x:Name="dpDOB" Grid.Row="9" Grid.Column="1" Margin="0,5" SelectedDate="{x:Static sys:DateTime.Now}"/>

        </Grid>

        <!-- Правая часть формы -->
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
            <!-- Фото -->
            <Border Width="200" Height="200" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,15">
                <Image x:Name="imgPhoto" Stretch="Uniform"/>
            </Border>
            <Button Content="Загрузить фото" Width="120" Click="BtnUploadPhoto_Click" Margin="0,0,0,15"/>

            <!-- Пароль -->
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Пароль:" Width="100" VerticalAlignment="Center"/>
                <PasswordBox x:Name="pwdPassword" Width="150" Margin="5,0" Visibility="Visible"/>
                <TextBox x:Name="txtPasswordVisible" Width="150" Margin="5,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Повтор пароля -->
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Повтор пароля:" Width="100" VerticalAlignment="Center"/>
                <PasswordBox x:Name="pwdConfirm" Width="150" Margin="5,0" Visibility="Visible"/>
                <TextBox x:Name="txtConfirmVisible" Width="150" Margin="5,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Чекбокс "Показать пароль" -->
            <CheckBox x:Name="chkShowPassword" Content="Показать пароль" Margin="10,5,0,0" 
                      Checked="chkShowPassword_Checked" Unchecked="chkShowPassword_Unchecked"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Ok" Width="80" Height="30" Margin="0,0,10,0" Click="Button_Click_1"/>
            <Button Content="Отмена" Width="80" Height="30" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>