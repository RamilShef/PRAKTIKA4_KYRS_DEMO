<Window x:Class="PRAKTIKA4_KYRS_DEMO.Profil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAKTIKA4_KYRS_DEMO"
        mc:Ignorable="d"
        Title="Профиль" MinHeight="550" MinWidth="900"
         WindowStartupLocation="CenterScreen">
    <Grid ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Профиль" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        <DataGrid Grid.Row="1" />
        <Button Grid.Row="2"  Content="Назад" Height="50" Width="70" Click="Button_Click" Margin="10"/>

    </Grid>
</Window>
