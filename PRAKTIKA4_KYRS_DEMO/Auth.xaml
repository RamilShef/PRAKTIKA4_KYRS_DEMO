<Window x:Class="PRAKTIKA4_KYRS_DEMO.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAKTIKA4_KYRS_DEMO"
        mc:Ignorable="d"
        Title="Авторизация" MinHeight="500" MinWidth="600"
    WindowStartupLocation="CenterScreen">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>


            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Авторизация" 
               HorizontalAlignment="Center" 
               FontSize="24" 
               FontWeight="Bold"
               Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Label Content="ID Number:" FontWeight="Bold" Foreground="#2c3e50" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="txtIdNumber" Height="30" FontSize="14" Padding="5" Width="200" VerticalAlignment="Center"/>
            </StackPanel>

        
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                <Label Content="Password:" FontWeight="Bold" Foreground="#2c3e50" Width="100" VerticalAlignment="Center"/>
                <PasswordBox x:Name="txtPassword" Height="30" FontSize="14" Padding="5" Width="200" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnLogin" Content="Вход" 
                    Width="80" 
                    Margin="0,0,10,0"
                        Click="btnLogin_Click"
                   />
                <Button x:Name="btnExit" Content="Назад" 
                        Width="80" 
                        Margin="0,0,10,0"
                            Click="btnExit_Click"
   />
            </StackPanel>
        </Grid>
    </Border>
</Window>
