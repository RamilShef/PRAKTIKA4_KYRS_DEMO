<Window x:Class="PRAKTIKA4_KYRS_DEMO.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Width="500" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f8f9fa">

    <Border Padding="15" Background="White" CornerRadius="5" BorderBrush="#dcdcdc" BorderThickness="1" Margin="10">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Label Grid.Row="0" Content="Авторизация"
                   HorizontalAlignment="Center"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

            <!-- ID -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <Label Content="ID:" FontWeight="Bold" Width="100" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBox x:Name="txtIdNumber"
                         Width="200"
                         Height="28"
                         FontSize="14"
                         Padding="5"/>
            </StackPanel>

            <!-- Пароль -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <Label Content="Пароль:" FontWeight="Bold" Width="100" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <PasswordBox x:Name="txtPassword"
                             Width="200"
                             Height="28"
                             FontSize="14"
                             Padding="5"/>
            </StackPanel>

            <!-- Запомнить меня -->
            <CheckBox x:Name="chkRememberMe"
                      Grid.Row="3"
                      Content="Запомнить меня"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0"/>

            <!-- Капча -->
            <StackPanel x:Name="captchaPanel" 
                        Grid.Row="4"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <TextBlock x:Name="captchaText" 
                           FontWeight="Bold" 
                           Foreground="DarkRed"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseDown="captchaText_MouseDown"
                           Margin="0,0,10,0"/>
                <TextBox x:Name="captchaInput" 
                         Width="100" 
                         Height="25"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
                <Button Content="⟳" Width="28" Height="25" Click="RefreshCaptcha_Click"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="btnLogin" 
                        Content="Вход" 
                        Width="90" 
                        Height="30"
                        Margin="0,0,10,0"
                        Click="btnLogin_Click"/>
                <Button x:Name="btnExit" 
                        Content="Назад" 
                        Width="90" 
                        Height="30"
                        Click="btnExit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
